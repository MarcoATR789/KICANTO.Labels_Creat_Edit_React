# Dependências instaladas pelo npm
node_modules/
**/node_modules/

# Builds gerados pelo React e por outras ferramentas
build/
dist/
frontend/build/

# Variáveis de ambiente locais
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs da aplicação, npm e PM2
logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pm2-before-login.log

# Cache de ferramentas de desenvolvimento
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Relatórios de testes e cobertura
coverage/
.nyc_output/

# Backups gerados do banco de dados
bkp_database/*.sql
bkp_database/*.bak
bkp_database/*.zip
!bkp_database/.gitkeep

# Arquivos temporários
tmp/
temp/
*.tmp

# Configurações locais de editores
.vscode/
.idea/
*.swp
*.swo

# Arquivos criados pelo sistema operacional
.DS_Store
Thumbs.db
desktop.ini
